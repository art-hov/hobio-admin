@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject IOptions<FirebaseOptions> FirebaseSettings
@inject IFirebaseTokenVerifier Verifier
@inject IAdminAllowList AllowList

<PageTitle>Sign in · Hobio Admin</PageTitle>

<main class="login-page">
    <section class="login-card" aria-labelledby="login-title">
        <img src="img/logo.svg" alt="Hobio" class="login-logo" />
        <h1 id="login-title">Hobio Admin</h1>
        <p class="login-sub">Sign in with an approved admin account.</p>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="login-alert @(IsInfo ? "info" : "error")" role="alert">@Message</div>
        }

        <div id="login-error" class="login-alert error" role="alert" hidden></div>

        @if (IsConfigured)
        {
            <button type="button" id="google-sign-in" class="login-button google">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                Continue with Google
            </button>

            <div class="login-divider"><span>or</span></div>

            <form id="email-sign-in" class="login-form" novalidate>
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="username" required />
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required />
                <button type="submit" class="login-button primary">Sign in</button>
            </form>
        }

        @* The browser posts the Firebase ID token here; the server verifies it and sets the session cookie. *@
        <form id="session-form" method="post" action="/auth/session" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="idToken" id="idToken" />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        </form>
    </section>

    <div id="firebase-config" hidden
         data-api-key="@FirebaseSettings.Value.WebApiKey"
         data-auth-domain="@AuthDomain"
         data-project-id="@ProjectId"></div>
</main>

@if (IsConfigured)
{
    <script type="module" src="@Assets["js/login.js"]"></script>
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "signedOut")]
    private string? SignedOut { get; set; }

    private string? ProjectId => FirebaseSettings.Value.ProjectId ?? Verifier.ProjectId;

    private string? AuthDomain => FirebaseSettings.Value.AuthDomain
        ?? (string.IsNullOrEmpty(ProjectId) ? null : $"{ProjectId}.firebaseapp.com");

    private bool IsConfigured =>
        !string.IsNullOrWhiteSpace(FirebaseSettings.Value.WebApiKey)
        && !string.IsNullOrWhiteSpace(ProjectId)
        && Verifier.IsConfigured
        && AllowList.IsConfigured;

    private bool IsInfo => Error is null && SignedOut is not null;

    private string? Message => !IsConfigured
        ? "Sign-in isn't configured yet. Set the Firebase web API key, the Firebase Admin SDK secret and the admin allow-list."
        : Error switch
        {
            null => SignedOut is not null ? "You've been signed out." : null,
            "not_authorized" => "This account isn't approved for Hobio Admin. Ask an owner to add your email to the allow-list.",
            "stale_sign_in" => "That sign-in took too long. Please try again.",
            "invalid_token" => "We couldn't verify that sign-in. Please try again.",
            "not_configured" => "Sign-in isn't configured on the server yet.",
            _ => "Sign-in failed. Please try again.",
        };
}
