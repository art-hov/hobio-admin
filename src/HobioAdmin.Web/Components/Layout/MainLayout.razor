@inherits LayoutComponentBase

<MudThemeProvider Theme="HobioTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="hobio-appbar" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle menu" />
        <a href="/" class="hobio-brand">
            <img src="img/logo.svg" alt="Hobio" class="hobio-brand-logo" />
            <span class="hobio-brand-text">Hobio <span class="hobio-brand-sub">Admin</span></span>
        </a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <span class="hobio-user d-none d-sm-inline">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                <form method="post" action="/auth/logout" class="d-inline">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Logout">Sign out</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Class="hobio-drawer">
        <MudNavMenu Color="Color.Primary" Bordered="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
            <MudNavLink Href="/cities" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocationCity">Cities &amp; weekdays</MudNavLink>
            <MudNavLink Href="/retention" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Repeat">Retention</MudNavLink>
            <MudNavLink Href="/investor-report" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">Investor report</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="hobio-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
</div>

@code {
    private bool _drawerOpen = true;
}
